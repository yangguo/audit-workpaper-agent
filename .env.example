# Copy this file to .env before starting the backend:
#   cp .env.example .env
# Then replace the placeholder values below. Never commit .env or real keys.

# OpenAI-compatible credentials shared by the agent and review engine.
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://api.example.com/v1

# The chat agent model and the Excel review model can be different.
# Change both model names to models available from your provider.
AGENT_LLM_MODEL=doubao-seed-2-0-pro-260215
AGENT_LLM_TEMPERATURE=0.7
AGENT_LLM_MAX_TOKENS=10000
AGENT_LLM_TIMEOUT=600
REVIEW_LLM_MODEL=doubao-seed-1-6-251015

# Local development defaults.
APP_ENV=DEV
WORKSPACE_PATH=.
FRONTEND_ORIGINS=http://localhost:3000

# Optional persistent services.
# PGDATABASE_URL=postgresql://user:password@localhost:5432/audit
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET_NAME=audit-workpapers
# S3_STORAGE_TOKEN=replace-with-storage-token

# The code also accepts OPENAI_API_KEY and OPENAI_BASE_URL as fallbacks,
# but prefer the LLM_* names above for a single, explicit configuration.

# Copy this file to .env before starting the backend:
#   cp .env.example .env
# Then replace the placeholder values below. Never commit .env or real keys.

# OpenAI-compatible credentials shared by the agent and review engine.
LLM_API_KEY=replace-with-your-llm-api-key
LLM_BASE_URL=https://api.example.com/v1

# The chat agent model and the Excel review model can be different.
# Change both model names to models available from your provider.
AGENT_LLM_MODEL=doubao-seed-2-0-pro-260215
AGENT_LLM_TEMPERATURE=0.7
AGENT_LLM_MAX_TOKENS=10000
AGENT_LLM_TIMEOUT=600
REVIEW_LLM_MODEL=doubao-seed-1-6-251015

# Additive finding-quality metadata. shadow preserves V1 conclusions and only
# records evidence/gate provenance; on applies fail-closed evidence downgrades;
# off keeps the legacy payload without the quality envelope.
REVIEW_RESULT_QUALITY_MODE=shadow
# Deterministic checks are cheap and run for fail/unknown findings by default.
REVIEW_DETERMINISTIC_CROSSCHECK_MODE=all_findings
# Keep report exports on the authoritative V1 source by default. The only
# candidate override is an explicit request with source=stage_c_shadow.

# Evidence discovery Agent: off, fallback (only for evidence gaps), or always.
REVIEW_EVIDENCE_AGENT_MODE=fallback
REVIEW_EVIDENCE_AGENT_MAX_STEPS=8

# Stage B deterministic policy-pack shadow execution. V1 findings remain
# authoritative; Stage B writes review-plan.json and policy-findings.json
# beside the shadow artifact. Set mode to off to disable this pilot.
REVIEW_POLICY_MODE=shadow
REVIEW_POLICY_PACK_ID=itgc-core
REVIEW_POLICY_PACK_VERSION=1.0.0
# REVIEW_POLICY_PACK_ROOT=./policy_packs
# REVIEW_ENGINE_VERSION=stage-b-policy-shadow

# Stage C bounded LLM judgement shadow execution. It is opt-in because it
# consumes REVIEW_LLM_MODEL/API capacity. V1 findings remain authoritative;
# Stage C writes judgements.json and v2-findings.json beside the shadow artifact.
REVIEW_JUDGEMENT_MODE=off
REVIEW_JUDGEMENT_PACK_ID=itgc-judgement
REVIEW_JUDGEMENT_PACK_VERSION=1.0.0
# REVIEW_JUDGEMENT_PACK_ROOT=./policy_packs
REVIEW_JUDGEMENT_MAX_REQUESTS=200

# Optional OCR for image/scanned/unsupported attachments. Keep off unless
# remote processing is approved for the audit data. auto uses the precise API
# when MINERU_TOKEN is set, otherwise the lightweight signed-upload API.
MINERU_OCR_MODE=off
# MINERU_TOKEN=replace-with-mineru-token
MINERU_MODEL_VERSION=vlm
MINERU_OCR_LANGUAGE=ch
MINERU_OCR_MAX_WAIT_SECONDS=300
MINERU_OCR_POLL_INTERVAL_SECONDS=2
MINERU_OCR_MAX_TEXT_CHARS=60000
# MINERU_BASE_URL=https://mineru.net
# Set 0/false to skip TLS certificate validation. Required when a corporate
# HTTPS proxy (e.g. KES / Kaspersky) intercepts MinerU's certificate chain.
# MINERU_VERIFY_SSL=1

# OpenAI-compatible LLM: skip TLS verification if a corporate proxy rewrites
# the certificate chain (Kaspersky/KES). Default: 1.
# LLM_VERIFY_SSL=1

# Optional LibreOffice conversion for legacy .xls/.doc attachments.
# soffice must be on PATH (install via OS package manager).
# Set 0 or empty to disable conversion; unsupported entries fall back gracefully.
LIBREOFFICE_CONVERT_TIMEOUT=30

# Adversarial challenger for P0 findings: feed bounded OCR snippets from
# embedded-media evidence so the challenger can refute findings based on
# screenshot content. Set 0 to disable and save tokens.
# REVIEW_CHALLENGER_FULL_TEXT=1

# Local development defaults.
APP_ENV=DEV
WORKSPACE_PATH=.
FRONTEND_ORIGINS=http://localhost:3000

# Optional persistent services.
# PGDATABASE_URL=postgresql://user:password@localhost:5432/audit
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET_NAME=audit-workpapers
# S3_STORAGE_TOKEN=replace-with-storage-token

# The code also accepts OPENAI_API_KEY and OPENAI_BASE_URL as fallbacks,
# but prefer the LLM_* names above for a single, explicit configuration.

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review quality manifest",
  "oneOf": [
    {"$ref": "#/$defs/legacy_manifest_v1"},
    {"$ref": "#/$defs/quality_manifest_v2"}
  ],
  "$defs": {
    "legacy_manifest_v1": {
      "type": "object",
      "required": ["schema_version", "cases"],
      "properties": {
        "schema_version": {"const": "review-quality/1"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/legacy_case_v1"}
        }
      }
    },
    "legacy_case_v1": {
      "type": "object",
      "required": ["case_id", "input_sha256", "adjudication_status", "expected_findings"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "minLength": 1},
        "adjudication_status": {"enum": ["pending", "adjudicated"]},
        "expected_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/expected_finding_v1"}
        }
      }
    },
    "expected_finding_v1": {
      "type": "object",
      "required": ["match_key", "status", "severity", "evidence_ids"],
      "properties": {
        "match_key": {"type": "object", "minProperties": 1},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "severity": {"enum": ["P0", "P1", "P2"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "primary_location": {"type": ["object", "null"]}
      }
    },
    "quality_manifest_v2": {
      "type": "object",
      "required": ["schema_version", "cases"],
      "properties": {
        "schema_version": {"const": "review-quality/2"},
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/quality_case_v2"}
        }
      }
    },
    "quality_case_v2": {
      "type": "object",
      "required": [
        "case_id",
        "input_sha256",
        "input_set_sha256",
        "execution_sha256",
        "minimum_runs",
        "adjudication_status",
        "expected_findings"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "input_sha256": {"type": "string", "minLength": 1},
        "input_set_sha256": {"type": "string", "minLength": 1},
        "execution_sha256": {"type": "string", "minLength": 1},
        "minimum_runs": {"type": "integer", "minimum": 5},
        "adjudication_status": {"enum": ["pending", "adjudicated"]},
        "expected_findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/expected_finding_v2"}
        }
      }
    },
    "controlled_match_key_v2": {
      "type": "object",
      "required": ["assertion_id", "claim_subject", "scope_key"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "claim_subject": {"type": "string", "minLength": 1},
        "scope_key": {"type": "string", "minLength": 1},
        "issue_type": {"type": "string"},
        "sheet": {"type": "string"},
        "cell": {"type": "string"}
      }
    },
    "duplicate_target_v2": {
      "type": "object",
      "required": ["assertion_id", "claim_subject", "scope_key"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1},
        "claim_subject": {"type": "string", "minLength": 1},
        "scope_key": {"type": "string", "minLength": 1}
      }
    },
    "expected_remediation_v2": {
      "type": "object",
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {
          "enum": ["actionable", "needs_human_refinement", "not_available"]
        }
      }
    },
    "expected_finding_v2": {
      "type": "object",
      "required": [
        "match_key",
        "status",
        "severity",
        "allowed_evidence_ids",
        "expected_duplicate_of",
        "expected_conflict",
        "expected_remediation"
      ],
      "properties": {
        "match_key": {"$ref": "#/$defs/controlled_match_key_v2"},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "severity": {"enum": ["P0", "P1", "P2"]},
        "allowed_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "requires_attachment_support": {"type": "boolean"},
        "expected_duplicate_of": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/duplicate_target_v2"}
          ]
        },
        "expected_conflict": {"type": "boolean"},
        "expected_remediation": {"$ref": "#/$defs/expected_remediation_v2"},
        "primary_location": {"type": ["object", "null"]}
      }
    }
  }
}
